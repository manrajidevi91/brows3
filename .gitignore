# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Monaco editor (auto-generated from node_modules during build)
/public/monaco-editor/


# Private credential files (ordinary source and databases remain eligible)
.env
.env.*
!.env.example
!.env.*.example
.ocr_key
.fernet_key
.encryption_key
id_rsa
id_ed25519
*.p12
*.pfx
*.ppk
service-account*.json
*_credentials.json
credentials.json
cookies.json
cookies_*.json

# SQLite databases stay local; never publish database files or journals.
*.sqlite
*.sqlite3
*.db
*.db3
*.sqlite-*
*.sqlite3-*
*.db-*
*.db3-*
